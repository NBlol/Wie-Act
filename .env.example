# ============================================================================
#  EdNova AI — configuration template  (copy to `.env`; NEVER commit real keys)
# ============================================================================

# --- Application -------------------------------------------------------------
APP_ENV=development
SECRET_KEY=replace-with-a-long-random-string          # JWT signing key (openssl rand -hex 32)
ACCESS_TOKEN_MINUTES=1440
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MAX_UPLOAD_MB=15

# --- Database ------------------------------------------------------------------
# PostgreSQL (docker-compose default) :
DATABASE_URL=postgresql://ednova:ednova@db:5432/ednova
# SQLite for a quick local run without PostgreSQL :
# DATABASE_URL=sqlite:///./ednova.db

# --- AI inference platform (two model categories) --------------------------------
# Leave AI_API_KEY empty to run in OFFLINE demo mode (clearly labelled in the UI).
# Credentials are personal to the team: do not share, log, screenshot or commit them.
AI_BASE_URL=                      # e.g. https://<platform-host>/v1   (OpenAI-compatible)  or  https://<host>  (Anthropic style)
AI_API_KEY=
AI_API_STYLE=openai               # openai | anthropic
AI_COMPACT_MODEL=                 # name of the compact / fast model category on the platform
AI_LARGE_MODEL=                   # name of the large / capable model category on the platform
AI_TIMEOUT_S=90
AI_MAX_RETRIES=2
AI_LARGE_CONCURRENCY=2            # max simultaneous large-model requests (queue beyond this)
AI_LARGE_QUEUE_WAIT_S=20          # max seconds to wait in the queue before falling back to the compact model
AI_BREAKER_FAILURES=3             # large-model failures within the window that open the circuit breaker
AI_BREAKER_WINDOW_S=120
AI_BREAKER_OPEN_S=90              # how long requests are routed to the compact model after the breaker opens
AI_CACHE_TTL_S=86400              # equivalent requests are served from cache for 24 h
AI_JSON_MODE=false                # set true if the platform supports response_format=json_object
AI_FORCE_OFFLINE=false            # force offline mode even if a key is present (demo of fallback behaviour)
AI_LOG_PROMPTS=false              # never enable in production: prompts contain learner text

# --- Rooms -----------------------------------------------------------------------
ROOM_MODERATOR_EVERY_N=6          # the moderator may intervene every N messages when participation is unbalanced

# --- Frontend ---------------------------------------------------------------------
API_PROXY=http://127.0.0.1:8000   # dev server proxy target for /api
